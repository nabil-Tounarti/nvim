return {
  "okuuva/auto-save.nvim",
  cmd = "ASToggle",
  event = { "InsertLeave", "TextChanged" },
  opts = {
    enabled = true, -- This activates it automatically on startup
    trigger_events = { "InsertLeave", "TextChanged" },
    condition = function(buf)
      local fn = vim.fn
      local utils = require("auto-save.utils.data")

      -- Don't auto-save read-only or special git buffers
      if fn.getbufvar(buf, "&modifiable") == 1 and
         utils.not_in(fn.getbufvar(buf, "&filetype"), { "gitcommit", "DiffviewFiles" }) then
        return true
      end
      return false
    end,
    write_all_buffers = false, -- Only save the current active file
    debounce_delay = 135,      -- Saves 135ms after you stop typing
  },
}
